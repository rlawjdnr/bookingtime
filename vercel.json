{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/push-reminders",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/push-reminders",
      "schedule": "0 7 * * *"
    }
  ]
}
