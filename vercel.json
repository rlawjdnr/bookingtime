{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/api/push-reminders/:slot",
      "destination": "/api/push-reminders?slot=:slot"
